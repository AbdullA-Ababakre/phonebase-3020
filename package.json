{
  "name": "phonebase-control-console",
  "version": "0.7.0",
  "private": true,
  "bin": {
    "phonebase": "./bin/phonebase.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "dev:3020": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev --hostname 127.0.0.1 --port 3020",
    "black:driver": "python3 bridge/black_arm_driver.py",
    "black:node": "tsx bridge/black_arm_node.ts",
    "fleet": "tsx bridge/fleet_supervisor.ts",
    "fleet:enroll": "PHONEBASE_FLEET_ENROLL_ONLY=1 tsx bridge/fleet_supervisor.ts",
    "control-plane": "tsx agent/server.ts",
    "vision": "tsx auto-setup/server.ts",
    "setup": "./scripts/setup-macos.sh",
    "onboard": "node bin/phonebase.mjs onboard",
    "phonebase": "node bin/phonebase.mjs",
    "local": "npm run build && ./start-local.sh",
    "mcp": "tsx mcp/server.ts",
    "remote:gateway": "tsx bridge/remote_gateway.ts",
    "remote": "./start-remote.sh",
    "black": "./start-black.sh",
    "doctor": "./scripts/doctor.sh",
    "acceptance:real": "node scripts/record-real-acceptance.mjs",
    "release:macos": "./scripts/build-release-macos.sh",
    "example:first-tap": "node examples/first-tap.mjs",
    "build": "npm run mcp:build && npm run docs:build && WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "start:3020": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start --hostname 127.0.0.1 --port 3020",
    "stable": "python3 scripts/supervisor.py",
    "stable:status": "python3 scripts/supervisor.py --status-once",
    "stable:install": "npm run build && python3 scripts/install_supervisor_macos.py",
    "test": "npm run test:unit && npm run test:mcp && npm run build && node --test tests/rendered-html.test.mjs",
    "test:unit": "tsx --test agent/*.test.ts auto-setup/*.test.ts bridge/*.test.ts && python3 -m unittest discover -s tests -p 'test_*.py'",
    "test:mcp": "node --test tests/mcp-protocol.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "docs:build": "node scripts/build-docs.mjs",
    "test:enterprise": "node --import tsx --test bridge/rental-leases.test.ts bridge/remote_gateway.integration.test.ts agent/rental-admin.integration.test.ts tests/enterprise-contract.test.ts",
    "mcp:build": "node scripts/build-mcp-client.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@phosphor-icons/react": "^2.1.10",
    "dotenv": "^17.4.2",
    "jpeg-js": "^0.4.4",
    "next": "^16.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.1",
    "@modelcontextprotocol/client": "^2.0.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "esbuild": "^0.28.1",
    "eslint": "9.39.4",
    "eslint-config-next": "^16.3.3",
    "react-server-dom-webpack": "^19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "^4.20.6",
    "typescript": "5.9.3",
    "vinext": "^1.0.0-beta.8",
    "vite": "^8.2.2",
    "wrangler": "^4.127.0"
  },
  "type": "module"
}
