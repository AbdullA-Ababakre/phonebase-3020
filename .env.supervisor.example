# Copy to .env.supervisor on the Phonebase Mac. This default is local-only:
# no public URL, remote token, gateway, or Tunnel is required.

# The supervisor can adopt already running 3020/3013/3014/3015/Node processes,
# so installing it does not discard a live manual reference.
PHONEBASE_BLACK_SERIAL=/dev/cu.usbserial-CHANGE_ME
PHONEBASE_BLACK_MAINTENANCE=1
PHONEBASE_BLACK_MAX_MANUAL_REFERENCE_OFFSET_MM=100
PHONEBASE_BLACK_RESTORE_MANUAL_REFERENCE=1
# A reference is restored only when all live controller coordinates still
# match this atomic checkpoint. A power cycle or controller-coordinate change
# stays locked; this does not replace calibration after moving the phone/fixture.
PHONEBASE_BLACK_REFERENCE_STATE_PATH=build/runtime/black-arm-reference.json
# US demo unit: its X input is physically stuck, so never launch an automatic
# sensor homing cycle. Healthy production units should set this to 1.
PHONEBASE_SUPERVISOR_AUTO_HOME=0

# Optional remote mode. Leave all of these unset for localhost operation.
# PHONEBASE_REMOTE_ALLOWED_ORIGINS=https://console.your-domain.example
# PHONEBASE_REMOTE_TOKEN=replace-with-at-least-32-random-characters
# PHONEBASE_REMOTE_PUBLIC_URL=https://station.your-domain.example
# PHONEBASE_CLOUD_CONSOLE_URL=https://phonebase-cloud-beta.alhazaranwar205.chatgpt.site/console
# PHONEBASE_REMOTE_MAINTENANCE=1
# PHONEBASE_REMOTE_MANUAL_REFERENCE_MAX_OFFSET_MM=100
# PHONEBASE_TUNNEL_COMMAND=cloudflared tunnel --no-autoupdate run --token REPLACE_ME

# Optional overrides.
# PHONEBASE_CONSOLE_PORT=3020
# PHONEBASE_CONSOLE_COMMAND=npm run start:3020
# PHONEBASE_CONTROL_PLANE_COMMAND=npm run control-plane
# PHONEBASE_SUPERVISOR_PORT=3016
# PHONEBASE_SUPERVISOR_INTERVAL=2
# PHONEBASE_SUPERVISOR_FAILURES=3
