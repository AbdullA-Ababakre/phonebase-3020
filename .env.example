# Local product surfaces. The Dashboard stays on the operator's machine and
# talks only to the safety-gated control plane by default.
PHONEBASE_CONSOLE_PORT=3020
PHONEBASE_CONTROL_PLANE_HOST=127.0.0.1
PHONEBASE_CONTROL_PLANE_PORT=3013
PHONEBASE_AUTO_SETUP_HOST=127.0.0.1
PHONEBASE_AUTO_SETUP_PORT=3031
PHONEBASE_AUTO_SETUP_STATE_DIRECTORY=.runtime/auto-setup

# MCP uses the same public API and cannot bypass any hardware gate.
PHONEBASE_API_URL=http://127.0.0.1:3013
# Homing stays hidden from Agents unless a local administrator opts in.
PHONEBASE_MCP_ALLOW_HOME=0

# Browser calibration writes and hot-loads the verified fixture profile here.
PHONEBASE_CALIBRATION_OUTPUT_PATH=build/runtime/phonebase-calibration.json

# Keep unset until a four-point profile has been physically verified. The
# The control plane refuses touch when this file is absent, unverified, for another
# device, or for a different camera frame size.
# PHONEBASE_CALIBRATION_PATH=/absolute/path/to/phonebase-calibration.json

# Optional public-test gateway. Generate a unique token at runtime and allow
# only the exact deployed console origin. Never commit the real token.
PHONEBASE_REMOTE_HOST=127.0.0.1
PHONEBASE_REMOTE_PORT=3015
PHONEBASE_REMOTE_UPSTREAM=http://127.0.0.1:3013
PHONEBASE_REMOTE_ALLOWED_ORIGINS=https://your-phonebase-console.example
PHONEBASE_REMOTE_TOKEN=replace-with-at-least-32-random-characters
# Optional separate signing secret for device-scoped monthly rental links.
# If omitted, Phonebase signs them with PHONEBASE_REMOTE_TOKEN.
# PHONEBASE_LEASE_SIGNING_SECRET=replace-with-at-least-32-random-characters
PHONEBASE_RENTAL_LEASES_PATH=.runtime/rental-leases.json
# Public HTTPS address that forwards to the local gateway on port 3015.
PHONEBASE_REMOTE_PUBLIC_URL=https://your-station-gateway.example
# macOS launchd remote session: fixed named tunnel configuration, preferred over
# temporary Quick Tunnels. See README for the private JSON/token-file format.
# PHONEBASE_REMOTE_NAMED_CONFIG_PATH=/absolute/path/to/named-remote.json
# Hosted console used by `phonebase cloud-link`.
PHONEBASE_CLOUD_CONSOLE_URL=https://phoneuse.com/console
PHONEBASE_AGENT_BUDGET_USD=0.50
PHONEBASE_AGENT_MAX_STEPS=36
PHONEBASE_REMOTE_FRAME_INTERVAL_MS=60
PHONEBASE_REMOTE_FRAME_WIDTH=360
PHONEBASE_REMOTE_FRAME_QUALITY=48
PHONEBASE_REMOTE_FOCUS_FRAME_WIDTH=640
PHONEBASE_REMOTE_FOCUS_FRAME_QUALITY=60

# Keep the production default at 15 mm. A supervised fixed demo fixture with
# a confirmed failed homing input can opt into a larger one-session offset.
PHONEBASE_BLACK_MAX_MANUAL_REFERENCE_OFFSET_MM=15
PHONEBASE_REMOTE_MANUAL_REFERENCE_MAX_OFFSET_MM=15

# Optional convenience pairing for a disposable hosted test console. Values
# prefixed with NEXT_PUBLIC are intentionally visible to site visitors.
NEXT_PUBLIC_PHONEBASE_REMOTE_CONTROL_PLANE_URL=https://your-tunnel.example
NEXT_PUBLIC_PHONEBASE_REMOTE_ACCESS_TOKEN=replace-with-the-same-public-test-token

# Production station supervisor. Put real values in ignored .env.supervisor.
PHONEBASE_SUPERVISOR_PORT=3016
PHONEBASE_SUPERVISOR_INTERVAL=2
PHONEBASE_SUPERVISOR_FAILURES=3
PHONEBASE_SUPERVISOR_AUTO_HOME=1
# Safe across a driver-only restart; a controller reset/coordinate change is rejected.
PHONEBASE_BLACK_RESTORE_MANUAL_REFERENCE=0
PHONEBASE_BLACK_INTERACTIVE_HOVER_MS=0
# Use a named Cloudflare Tunnel; Quick Tunnel URLs are intentionally temporary.
# PHONEBASE_TUNNEL_COMMAND=cloudflared tunnel --no-autoupdate run --token YOUR_TOKEN
